#!/bin/sh
set -e

# Ensure pigpio daemon is enabled
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable pigpiod || true
  systemctl start pigpiod || true
fi

# Set up data and log files
if id gnome >/dev/null 2>&1; then
  install -d -o gnome -g gnome /data/enpi
  install -d -o gnome -g gnome /var/log/enpi
else
  install -d /data/enpi
  install -d /var/log/enpi
fi

# Create directory for per-device certificate (written by enpi-provision.service on first boot)
install -d -m 700 /etc/enpi


# Set up udev rules
RULE_SRC=/opt/sensorgnome/enpi/udev/10-enpi.rules
RULE_DST=/etc/udev/rules.d/10-enpi.rules

if [ -f "$RULE_SRC" ]; then
  install -m 644 "$RULE_SRC" "$RULE_DST"
  udevadm control --reload-rules || true
  udevadm trigger || true
fi


# Install Python dependencies that are not available as Debian packages
# Install in virtual envorinment
VENV_DIR=/opt/sensorgnome/enpi/env

if [ ! -d "$VENV_DIR" ]; then
  python3 -m venv "$VENV_DIR"
fi

# Upgrade pip inside venv
"$VENV_DIR/bin/pip" install --no-cache-dir --upgrade pip

# Install required Python libraries
"$VENV_DIR/bin/pip" install --no-cache-dir \
  adafruit-blinka \
  adafruit-circuitpython-bmp280 \
  adafruit-circuitpython-bme280 \
  boto3 \
  botocore \
  awsiotsdk


# Install and enable the first-boot provisioning service
install -m 644 /opt/sensorgnome/enpi/provisioning/enpi-provision.service /etc/systemd/system/
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload
  systemctl enable enpi-provision.service || true
fi

exit 0