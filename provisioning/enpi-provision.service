[Unit]
Description=ENPI first-boot device provisioning
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/enpi/device-cert.pem

[Service]
Type=oneshot
ExecStart=/opt/sensorgnome/enpi/env/bin/python3 /opt/sensorgnome/enpi/provisioning/provision-device.py
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
